{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "C/C++: g++.exe build active file",
			"command": "D:\\mingw\\ucrt64\\bin\\g++.exe",
			"args": [
				"-fdiagnostics-color=always",
				"-g",
				"${file}",
				"D:/mingw/ucrt64/lib/glad.c",
				"-o",
				"${fileDirname}\\${fileBasenameNoExtension}.exe",
				"-ID:/mingw/ucrt64/include",
        		"-LD:/mingw/ucrt64/lib",
        		"-lglfw3",
        		"-lopengl32",
        		"-lgdi32"


			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "compiler: D:\\mingw\\ucrt64\\bin\\g++.exe"
		}
	]
}